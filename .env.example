# Plantilla de variables de entorno para levantar Tero en local con docker compose.
# Copiar a .env y completar los valores:   cp .env.example .env
# El .env real NO se versiona (está en .gitignore).
#
# Usar valores aleatorios de solo letras y números (sin espacios, comillas, \, $ ni #): compose
# interpreta $ y # dentro del .env, y la contraseña de Redis va en el archivo de configuración
# de Redis, donde una comilla simple hace que no arranque. Los servicios sí aceptan cualquier
# carácter en la contraseña de la base. Para generar 64 caracteres hexadecimales:
#   Git Bash:    openssl rand -hex 32
#   PowerShell:  $b=[byte[]]::new(32); [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })

# Contraseña del usuario retail_user de PostgreSQL (la usan db, catalog, carts, orders y admin)
POSTGRES_PASSWORD=

# Contraseña de Redis (la usan redis y checkout)
REDIS_PASSWORD=

# Panel de administración
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Secreto para firmar los JWT del admin: un valor largo y aleatorio, generado como se explica arriba
ADMIN_JWT_SECRET=
