# Los scripts de shell van siempre con finales de línea LF, también en Windows:
# con CRLF, bash falla ($'\r': command not found).
*.sh text eol=lf

# Configuración que leen herramientas dentro de contenedores Linux (Gitleaks y Trivy), también
# cuando se corren en Windows: con CRLF, los fingerprints de .gitleaksignore no coinciden.
.gitleaks.toml text eol=lf
.gitleaksignore text eol=lf
.trivyignore text eol=lf
