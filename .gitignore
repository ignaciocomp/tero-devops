# Variables de entorno locales: el .env real nunca se versiona (plantilla en .env.example)
.env
.env.*
!.env.example

# Ajustes locales de compose, como publicar la base para un cliente SQL. Compose carga
# automáticamente cualquiera de estos cuatro nombres, así que se ignoran todos
docker-compose.override.yml
docker-compose.override.yaml
compose.override.yml
compose.override.yaml

# Dependencias y artefactos de build
node_modules/
dist/
__pycache__/
*.py[cod]
.venv/

# Yarn 4 (checkout), como recomienda Yarn sin Zero-Installs: se ignoran la caché, el
# estado de instalación y los archivos de PnP, pero se versionan releases, plugins,
# patches, sdks y versions
**/.pnp.*
**/.yarn/*
!**/.yarn/releases/
!**/.yarn/plugins/
!**/.yarn/patches/
!**/.yarn/sdks/
!**/.yarn/versions/

# Terraform: providers descargados y estado (el estado puede contener secretos)
.terraform/
*.tfstate
*.tfstate.*
# Planes guardados con -out: llevan los valores del plan
*.tfplan

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
