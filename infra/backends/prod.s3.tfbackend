# Estado de prod. El bucket no va acá porque su nombre depende de la cuenta: se pasa en el init.
#   terraform init -backend-config=backends/prod.s3.tfbackend -backend-config="bucket=$TF_STATE_BUCKET"
key          = "tero/prod/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true
