# Qué NO se manda al build. Lo que no entra al contexto no puede terminar en la imagen.

# Secretos y configuración local
**/.env
**/.env.*
**/*.env
**/.envrc
**/.npmrc

# Dependencias y compilados: se generan dentro de la imagen
node_modules
dist
coverage
*.tsbuildinfo

# Yarn 4: entra solo lo versionado (el binario y, si existen, patches y plugins);
# la caché y el estado de instalación se generan dentro de la imagen
.yarn/*
!.yarn/releases
!.yarn/patches
!.yarn/plugins
.pnp.*

# Control de versiones, editores y archivos que no hacen falta para construir
.git
.gitignore
.dockerignore
Dockerfile
*.md
.vscode
.idea
